  | .output, v => toString v
  | .parseOnly, v => toString v
  | .preprocessOnly, v => toString v
  | .rlimit, v => toString v
  | .rlimitPer, v => toString v
  | .stats, v => toString v
  | .statsAll, v => toString v
  | .statsInternal, v => toString v
  | .tlimit, v => toString v
