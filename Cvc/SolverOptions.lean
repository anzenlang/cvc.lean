  | .none => "none"
  | .basic => "basic"
  | .agg => "agg"

instance : ToString SimpleSymBreak := ⟨SimpleSymBreak.toString⟩

/-- Modes for sampling with counterexample-guided inductive synthesis (CEGIS). -/
inductive CegisSample where
  /-- `none`: Do not use sampling with CEGIS (the default). -/
  | none
  /-- `use`.

  Use sampling to accelerate CEGIS. This will rule out solutions for a conjecture when they are
  not satisfied by a sample point.
  -/
  | use
  /-- `trust`.

  Trust that when a solution for a conjecture is always true under sampling, then it is indeed a
  solution. Note this option may print out spurious solutions for synthesis conjectures.
  -/
  | trust
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--cegis-sample`. -/
def CegisSample.toString : CegisSample → String
  | .none => "none"
  | .use => "use"
  | .trust => "trust"

instance : ToString CegisSample := ⟨CegisSample.toString⟩

/-- Modes for sygus enumeration. -/
inductive Enum where
  /-- `smart`: Use smart enumeration based on datatype constraints. -/
  | smart
  /-- `fast`: Use optimized enumerator for sygus enumeration. -/
  | fast
  /-- `random`: Use basic random enumerator for sygus enumeration. -/
  | random
  /-- `var-agnostic`: Use sygus solver to enumerate terms that are agnostic to variables. -/
  | varAgnostic
  /-- `auto`: Internally decide the best policy for each enumerator (the default). -/
  | auto
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--sygus-enum`. -/
def Enum.toString : Enum → String
  | .smart => "smart"
  | .fast => "fast"
  | .random => "random"
  | .varAgnostic => "var-agnostic"
  | .auto => "auto"

instance : ToString Enum := ⟨Enum.toString⟩

/-- Modes for sygus evaluation unfolding. -/
inductive EvalUnfold where
  /-- `none`: Do not use sygus evaluation unfolding. -/
  | none
  /-- `single`: Do single-step unfolding for all evaluation functions. -/
  | single
  /-- `single-bool`.

  Do single-step unfolding for Boolean functions and ITEs, and multi-step unfolding for all others
  (the default).
  -/
  | singleBool
  /-- `multi`: Do multi-step unfolding for all evaluation functions. -/
  | multi
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--sygus-eval-unfold`. -/
def EvalUnfold.toString : EvalUnfold → String
  | .none => "none"
  | .single => "single"
  | .singleBool => "single-bool"
  | .multi => "multi"

instance : ToString EvalUnfold := ⟨EvalUnfold.toString⟩

/-- Modes for default SyGuS grammars. -/
inductive GrammarCons where
  /-- `simple`: Use simple grammar construction (no symbolic terms or constants) (the default). -/
  | simple
  /-- `any-const`: Use symoblic constant constructors. -/
  | anyConst
  /-- `any-term`.

  When applicable, use constructors corresponding to any symbolic term. This option enables a
  sum-of-monomials grammar for arithmetic. For all other types, it enables symbolic constant
  constructors.
  -/
  | anyTerm
  /-- `any-term-concise`.

  When applicable, use constructors corresponding to any symbolic term, favoring conciseness over
  generality. This option is equivalent to any-term but enables a polynomial grammar for
  arithmetic when not in a combined theory.
  -/
  | anyTermConcise
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--sygus-grammar-cons`. -/
def GrammarCons.toString : GrammarCons → String
  | .simple => "simple"
  | .anyConst => "any-const"
  | .anyTerm => "any-term"
  | .anyTermConcise => "any-term-concise"

instance : ToString GrammarCons := ⟨GrammarCons.toString⟩

/-- Template modes for sygus invariant synthesis. -/
inductive InvTempl where
  /-- `none`: Synthesize invariant directly. -/
  | none
  /-- `pre`: Synthesize invariant based on weakening of precondition. -/
  | pre
  /-- `post`: Synthesize invariant based on strengthening of postcondition (the default). -/
  | post
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--sygus-inv-templ`. -/
def InvTempl.toString : InvTempl → String
  | .none => "none"
  | .pre => "pre"
  | .post => "post"

instance : ToString InvTempl := ⟨InvTempl.toString⟩

/-- Modes for sygus solution output. -/
inductive Out where
  /-- `status`: Print only status for check-synth calls. -/
  | status
  /-- `status-and-def`: Print status followed by definition corresponding to solution. -/
  | statusAndDef
  /-- `sygus-standard`: Print based on SyGuS standard (the default). -/
  | sygusStandard
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--sygus-out`. -/
def Out.toString : Out → String
  | .status => "status"
  | .statusAndDef => "status-and-def"
  | .sygusStandard => "sygus-standard"

instance : ToString Out := ⟨Out.toString⟩

/-- Modes for single invocation techniques. -/
inductive Si where
  /-- `none`: Do not use single invocation techniques (the default). -/
  | none
  /-- `use`: Use single invocation techniques only if grammar is not restrictive. -/
  | use
  /-- `all`: Always use single invocation techniques. -/
  | all
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--sygus-si`. -/
def Si.toString : Si → String
  | .none => "none"
  | .use => "use"
  | .all => "all"

instance : ToString Si := ⟨Si.toString⟩

/-- Modes for reconstruction solutions while using single invocation techniques. -/
inductive SiRcons where
  /-- `none`.

  Do not try to reconstruct solutions in the original (user-provided) grammar when using single
  invocation techniques. In this mode, solutions produced by cvc5 may violate grammar
  restrictions.
  -/
  | none
  /-- `try`.

  Try to reconstruct solutions in the original grammar when using single invocation techniques in
  an incomplete (fail-fast) manner.
  -/
  | «try»
  /-- `all-limit`.

  Try to reconstruct solutions in the original grammar, but terminate if a maximum number of
  rounds for reconstruction is exceeded.
  -/
  | allLimit
  /-- `all`.

  Try to reconstruct solutions in the original grammar. In this mode, we do not terminate until a
  solution is successfully reconstructed (the default).
  -/
  | all
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--sygus-si-rcons`. -/
def SiRcons.toString : SiRcons → String
  | .none => "none"
  | .«try» => "try"
  | .allLimit => "all-limit"
  | .all => "all"

instance : ToString SiRcons := ⟨SiRcons.toString⟩

/-- Modes for piecewise-independent unification. -/
inductive UnifPi where
  /-- `none`: Do not use piecewise-independent unification (the default). -/
  | none
  /-- `complete`.

  Use complete approach for piecewise-independent unification (see Section 3 of Barbosa et al
  FMCAD 2019).
  -/
  | complete
  /-- `cond-enum`.

  Use unconstrained condition enumeration for piecewise-independent unification (see Section 4 of
  Barbosa et al FMCAD 2019).
  -/
  | condEnum
  /-- `cond-enum-igain`.

  Same as cond-enum, but additionally uses an information gain heuristic when doing decision tree
  learning.
  -/
  | condEnumIgain
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--sygus-unif-pi`. -/
def UnifPi.toString : UnifPi → String
  | .none => "none"
  | .complete => "complete"
  | .condEnum => "cond-enum"
  | .condEnumIgain => "cond-enum-igain"

instance : ToString UnifPi := ⟨UnifPi.toString⟩

end Option.Sygus

/-- Syntax-guided synthesis. -/
inductive Option.Sygus where
  /-- `--sygus-abort-size`.

  Tells enumerative sygus to only consider solutions up to term size N (-1 == no limit, default).
  -/
  | abortSize
  /-- `--sygus-fair`: If and how to apply fairness for sygus. -/
  | fair
  /-- `--sygus-rewriter`: If and how to apply rewriting for sygus symmetry breaking. -/
  | rewriter
  /-- `--sygus-simple-sym-break`.

  If and how to apply simple symmetry breaking based on the grammar for smart enumeration.
  -/
  | simpleSymBreak
  /-- `--sygus-sym-break-pbe`: Sygus symmetry breaking lemmas based on pbe conjectures. -/
  | symBreakPbe
  /-- `--cegis-sample`.

  Mode for using samples in the counterexample-guided inductive synthesis loop.
  -/
  | cegisSample
  /-- `--sygus`: Support SyGuS commands. -/
  | sygus
  /-- `--sygus-add-const-grammar`: Statically add constants appearing in conjecture to grammars. -/
  | addConstGrammar
  /-- `--sygus-core-connective`.

  Use unsat core analysis to construct Boolean connective to sygus conjectures.
  -/
  | coreConnective
  /-- `--sygus-enum`: Mode for sygus enumeration. -/
  | enum
  /-- `--sygus-eval-unfold`: Modes for sygus evaluation unfolding. -/
  | evalUnfold
  /-- `--sygus-grammar-cons`: Mode for SyGuS grammar construction. -/
  | grammarCons
  /-- `--sygus-inst`: Enable SyGuS instantiation quantifiers module. -/
  | inst
  /-- `--sygus-inv-templ`.

  Template mode for sygus invariant synthesis (weaken pre-condition, strengthen post-condition, or
  none).
  -/
  | invTempl
  /-- `--sygus-min-grammar`: Statically minimize sygus grammars. -/
  | minGrammar
  /-- `--sygus-out`: Output mode for sygus. -/
  | out
  /-- `--sygus-pbe`.

  Enable approach which unifies conditional solutions, specialized for programming-by-examples
  (pbe) conjectures.
  -/
  | pbe
  /-- `--sygus-repair-const`: Use approach to repair constants in sygus candidate solutions. -/
  | repairConst
  /-- `--sygus-si`: Mode for processing single invocation synthesis conjectures. -/
  | si
  /-- `--sygus-si-abort`: Abort if synthesis conjecture is not single invocation. -/
  | siAbort
  /-- `--sygus-si-rcons`: Policy for reconstructing solutions for single invocation conjectures. -/
  | siRcons
  /-- `--sygus-stream`.

  Enumerate a stream of solutions instead of terminating after the first one.
  -/
  | stream
  /-- `--sygus-unif-pi`: Mode for synthesis via piecewise-indepedent unification. -/
  | unifPi
  /-- `--sygus-verify-timeout`.

  Timeout (in milliseconds) for verifying satisfiability of synthesized terms (0 == no limit).
  -/
  | verifyTimeout
deriving Inhabited, DecidableEq, Repr

namespace Option.Sygus

