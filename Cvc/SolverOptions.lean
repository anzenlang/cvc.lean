namespace Option.Proof

/-- Internal proof checking modes. -/
inductive Check where
  /-- `eager`: Check rule applications and proofs from generators eagerly for local debugging. -/
  | eager
  /-- `eager-simple`: Check rule applications during construction. -/
  | eagerSimple
  /-- `lazy`: Check rule applications only during final proof construction. -/
  | lazy
  /-- `none`: Do not check rule applications (the default). -/
  | none
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--proof-check`. -/
def Check.toString : Check → String
  | .eager => "eager"
  | .eagerSimple => "eager-simple"
  | .lazy => "lazy"
  | .none => "none"

instance : ToString Check := ⟨Check.toString⟩

/-- Modes for proof granularity. -/
inductive Granularity where
  /-- `macro`: Allow macros. Do not improve the granularity of proofs (the default). -/
  | «macro»
  /-- `rewrite`: Allow trusted rewrite or substitution steps, expand macros. -/
  | rewrite
  /-- `theory-rewrite`.

  Allow trusted theory rewrite steps, expand macros, rewrite and substitution steps.
  -/
  | theoryRewrite
  /-- `dsl-rewrite`.

