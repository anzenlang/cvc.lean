namespace Option.Smt

/-- Decision modes. -/
inductive Decision where
  /-- `internal`: Use the internal decision heuristics of the SAT solver (the default). -/
  | internal
  /-- `justification`: An ATGP-inspired justification heuristic. -/
  | justification
  /-- `stoponly`: Use the justification heuristic only to stop early, not for decisions. -/
  | stoponly
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--decision`. -/
def Decision.toString : Decision → String
  | .internal => "internal"
  | .justification => "justification"
  | .stoponly => "stoponly"

instance : ToString Decision := ⟨Decision.toString⟩

/-- Interpolants grammar mode. -/
inductive InterpolantsMode where
  /-- `default`: Use the default grammar for the theory or the user-defined grammar if given. -/
  | default
  /-- `assumptions`: Use only operators that occur in the assumptions. -/
  | assumptions
  /-- `conjecture`: Use only operators that occur in the conjecture. -/
  | conjecture
  /-- `shared`: Use only operators that occur both in the assumptions and the conjecture. -/
  | shared
  /-- `all`: Use only operators that occur either in the assumptions or the conjecture. -/
  | all
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--interpolants-mode`. -/
def InterpolantsMode.toString : InterpolantsMode → String
  | .default => "default"
  | .assumptions => "assumptions"
  | .conjecture => "conjecture"
  | .shared => "shared"
  | .all => "all"

instance : ToString InterpolantsMode := ⟨InterpolantsMode.toString⟩

/-- Model cores modes. -/
inductive ModelCores where
  /-- `none`: Do not compute model cores (the default). -/
  | none
  /-- `simple`.

  Only include a subset of variables whose values are sufficient to show the input formula is
  satisfied by the given model.
  -/
  | simple
  /-- `non-implied`.

  Only include a subset of variables whose values, in addition to the values of variables whose
  values are implied, are sufficient to show the input formula is satisfied by the given model.
  -/
  | nonImplied
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--model-cores`. -/
def ModelCores.toString : ModelCores → String
  | .none => "none"
  | .simple => "simple"
  | .nonImplied => "non-implied"

instance : ToString ModelCores := ⟨ModelCores.toString⟩

/-- Simplification modes. -/
inductive Simplification where
  /-- `none`: Do not perform nonclausal simplification. -/
  | none
  /-- `batch`.

  Save up all ASSERTions; run nonclausal simplification and clausal (MiniSat) propagation for all
  of them only after reaching a querying command (CHECKSAT or QUERY or predicate SUBTYPE
  declaration) (the default).
  -/
  | batch
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--simplification`. -/
def Simplification.toString : Simplification → String
  | .none => "none"
  | .batch => "batch"

instance : ToString Simplification := ⟨Simplification.toString⟩

/-- Solve-bv-as-int modes. -/
inductive SolveBvAsInt where
  /-- `off`: Do not translate bit-vectors to integers (the default). -/
  | off
  /-- `sum`.

  Generate a sum expression for each bvand instance, based on the value in
  --solve-bv-as-int-granularity.
  -/
  | sum
  /-- `iand`: Translate bvand to the iand operator. -/
  | iand
  /-- `bv`: Translate bvand back to bit-vectors. -/
  | bv
  /-- `bitwise`: Introduce a UF operator for bvand, and eagerly add bitwise lemmas. -/
  | bitwise
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--solve-bv-as-int`. -/
def SolveBvAsInt.toString : SolveBvAsInt → String
  | .off => "off"
  | .sum => "sum"
  | .iand => "iand"
  | .bv => "bv"
  | .bitwise => "bitwise"

instance : ToString SolveBvAsInt := ⟨SolveBvAsInt.toString⟩

end Option.Smt

/-- The SMT layer: what a check can produce, self-checks, preprocessing. -/
inductive Option.Smt where
  /-- `--decision`: Choose decision mode. -/
  | decision
  /-- `--check-abducts`: Checks whether produced solutions to get-abduct are correct. -/
  | checkAbducts
  /-- `--check-interpolants`: Checks whether produced solutions to get-interpolant are correct. -/
  | checkInterpolants
  /-- `--check-model-subsolver`.

  Use subsolver to compute values when applicable in calls to get-value and check-models.
  -/
  | checkModelSubsolver
  /-- `--check-models`.

  After SAT/INVALID/UNKNOWN, check that the generated model satisfies user assertions.
  -/
  | checkModels
  /-- `--check-proofs`: After UNSAT/VALID, check the generated proof (with proof). -/
  | checkProofs
  /-- `--check-synth-sol`.

  Checks whether produced solutions to functions-to-synthesize satisfy the conjecture.
  -/
  | checkSynthSol
  /-- `--check-unsat-cores`: After UNSAT/VALID, produce and check an unsat core (expensive). -/
  | checkUnsatCores
  /-- `--debug-check-models`.

  After SAT/INVALID/UNKNOWN, check that the generated model satisfies user and internal
  assertions.
  -/
  | debugCheckModels
  /-- `--produce-models`: Support the get-value and get-model commands. -/
  | produceModels
  /-- `--produce-proofs`: Produce proofs, support check-proofs and get-proof. -/
  | produceProofs
  /-- `--produce-unsat-cores`.

  Turn on unsat core generation. Unless otherwise specified, cores will be produced using SAT
  soving under assumptions and preprocessing proofs.
  -/
  | produceUnsatCores
  /-- `--interpolants-mode`: Choose interpolants production mode. -/
  | interpolantsMode
  /-- `--learned-rewrite`: Rewrite the input based on learned literals. -/
  | learnedRewrite
  /-- `--model-cores`: Mode for producing model cores. -/
  | modelCores
  /-- `--print-cores-full`.

  Print all formulas regardless of whether they are named, e.g. in unsat cores.
  -/
  | printCoresFull
  /-- `--produce-abducts`: Support the get-abduct command. -/
  | produceAbducts
  /-- `--produce-assertions`: Keep an assertions list. Note this option is always enabled. -/
  | produceAssertions
  /-- `--produce-assignments`: Support the get-assignment command. -/
  | produceAssignments
  /-- `--produce-difficulty`: Enable tracking of difficulty. -/
  | produceDifficulty
  /-- `--produce-interpolants`: Turn on interpolation generation. -/
  | produceInterpolants
  /-- `--produce-learned-literals`: Produce learned literals, support get-learned-literals. -/
  | produceLearnedLiterals
  /-- `--produce-unsat-assumptions`: Turn on unsat assumptions generation. -/
  | produceUnsatAssumptions
  /-- `--simplification`: Choose simplification mode. -/
  | simplification
  /-- `--solve-bv-as-int`: Mode for translating BVAnd to integer. -/
  | solveBvAsInt
  /-- `--solve-int-as-bv`.

  Attempt to solve a pure integer satisfiable problem by bitblasting in sufficient bitwidth
  (experimental).
  -/
  | solveIntAsBv
  /-- `--solve-real-as-int`.

  Attempt to solve a pure real satisfiable problem as an integer problem (for non-linear).
  -/
  | solveRealAsInt
  /-- `--static-learning`: Use static learning (on by default). -/
  | staticLearning
deriving Inhabited, DecidableEq, Repr

