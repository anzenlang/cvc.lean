namespace Option.Printing

/-- Output languages. -/
inductive OutputLang where
  /-- `auto`: Match output language to input language (the default). -/
  | auto
  /-- `smt2`: SMT-LIB format 2.6 with support for the strings standard. -/
  | smtLib
  /-- `ast`: Internal format (simple syntax trees). -/
  | ast
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--output-lang`. -/
def OutputLang.toString : OutputLang → String
  | .auto => "auto"
  | .smtLib => "smt2"
  | .ast => "ast"

instance : ToString OutputLang := ⟨OutputLang.toString⟩

/-- Uninterpreted elements in models printing modes. -/
inductive ModelUPrint where
  /-- `decl-sort-and-fun`.

  Print uninterpreted elements declare-fun, and also include a declare-sort for the sort.
  -/
  | declSortAndFun
  /-- `decl-fun`.

  Print uninterpreted elements declare-fun, but don't include a declare-sort for the sort.
  -/
  | declFun
  /-- `dt`: Print uninterpreted elements as a declare-datatype. -/
  | dt
  /-- `none`.

  (default) do not print declarations of uninterpreted elements in models (the default).
  -/
  | none
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--model-u-print`. -/
def ModelUPrint.toString : ModelUPrint → String
  | .declSortAndFun => "decl-sort-and-fun"
  | .declFun => "decl-fun"
  | .dt => "dt"
  | .none => "none"

instance : ToString ModelUPrint := ⟨ModelUPrint.toString⟩

end Option.Printing

/-- How terms and models are printed. -/
inductive Option.Printing where
  /-- `--print-success`: Print the "success" output required of SMT-LIBv2. -/
  | printSuccess
  /-- `--dag-thresh`.

  Dagify common subexprs appearing > N times (1 == default, 0 == don't dagify).
  -/
  | dagThresh
  /-- `--expr-depth`: Print exprs to depth N (0 == default, -1 == no limit). -/
  | exprDepth
  /-- `--output-lang`: Force output language. -/
  | outputLang
  /-- `--bv-print-consts-as-indexed-symbols`.

  Print bit-vector constants in decimal (e.g. (_ bv1 4)) instead of binary (e.g. #b0001), applies
  to SMT-LIB 2.x.
  -/
  | bvPrintConstsAsIndexedSymbols
  /-- `--model-u-print`: Determines how to print uninterpreted elements in models. -/
  | modelUPrint
deriving Inhabited, DecidableEq, Repr

namespace Option.Printing

/-- The option's name, as cvc5 spells it. -/
def name : Printing → String
  | .printSuccess => "print-success"
  | .dagThresh => "dag-thresh"
