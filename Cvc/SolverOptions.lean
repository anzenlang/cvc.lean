namespace Option.Quant

/-- Print format for printing instantiations. -/
inductive PrintInst where
  /-- `list`.

  Print the list of instantiations per quantified formula, when non-empty (the default).
  -/
  | list
  /-- `num`: Print the total number of instantiations per quantified formula, when non-zero. -/
  | num
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--print-inst`. -/
def PrintInst.toString : PrintInst → String
  | .list => "list"
  | .num => "num"

instance : ToString PrintInst := ⟨PrintInst.toString⟩

/-- Quantifier conflict find modes. -/
inductive CbqiMode where
  /-- `conflict`: Apply QCF algorithm to find conflicts only. -/
  | conflict
  /-- `prop-eq`: Apply QCF algorithm to propagate equalities as well as conflicts (the default). -/
  | propEq
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--cbqi-mode`. -/
def CbqiMode.toString : CbqiMode → String
  | .conflict => "conflict"
  | .propEq => "prop-eq"

instance : ToString CbqiMode := ⟨CbqiMode.toString⟩

/-- Mode for using instantiation evaluation. -/
inductive Ieval where
  /-- `off`: Do not use instantiation evaluation. -/
  | off
  /-- `use`: Use instantiation evaluation (the default). -/
  | use
  /-- `use-learn`: Use instantiation evaluation, and generalize learning. -/
  | useLearn
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--ieval`. -/
def Ieval.toString : Ieval → String
  | .off => "off"
  | .use => "use"
  | .useLearn => "use-learn"

instance : ToString Ieval := ⟨Ieval.toString⟩

/-- Instantiation modes. -/
inductive InstWhen where
  /-- `full`: Run instantiation round at full effort, before theory combination. -/
  | full
  /-- `full-delay`.

  Run instantiation round at full effort, before theory combination, after all other theories have
  finished.
  -/
  | fullDelay
  /-- `full-last-call`.

  Alternate running instantiation rounds at full effort and last call.  In other words, interleave
  instantiation and theory combination (the default).
  -/
  | fullLastCall
  /-- `full-delay-last-call`.

  Alternate running instantiation rounds at full effort after all other theories have finished,
  and last call.
  -/
  | fullDelayLastCall
  /-- `last-call`.

  Run instantiation at last call effort, after theory combination and and theories report sat.
  -/
  | lastCall
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--inst-when`. -/
def InstWhen.toString : InstWhen → String
  | .full => "full"
  | .fullDelay => "full-delay"
  | .fullLastCall => "full-last-call"
  | .fullDelayLastCall => "full-delay-last-call"
  | .lastCall => "last-call"

instance : ToString InstWhen := ⟨InstWhen.toString⟩

/-- ITE lifting modes for quantified formulas. -/
inductive IteLiftQuant where
  /-- `none`: Do not lift if-then-else in quantified formulas. -/
  | none
  /-- `simple`.

  Lift if-then-else in quantified formulas if results in smaller term size (the default).
  -/
  | simple
  /-- `all`: Lift if-then-else in quantified formulas. -/
  | all
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--ite-lift-quant`. -/
def IteLiftQuant.toString : IteLiftQuant → String
  | .none => "none"
  | .simple => "simple"
  | .all => "all"

instance : ToString IteLiftQuant := ⟨IteLiftQuant.toString⟩

/-- Modes for quantifiers macro expansion. -/
inductive MacrosQuantMode where
  /-- `all`: Infer definitions for functions, including those containing quantified formulas. -/
  | all
  /-- `ground`: Only infer ground definitions for functions. -/
  | ground
  /-- `ground-uf`.

  Only infer ground definitions for functions that result in triggers for all free variables (the
  default).
  -/
  | groundUf
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--macros-quant-mode`. -/
def MacrosQuantMode.toString : MacrosQuantMode → String
  | .all => "all"
  | .ground => "ground"
  | .groundUf => "ground-uf"

instance : ToString MacrosQuantMode := ⟨MacrosQuantMode.toString⟩

/-- Miniscope quantifiers modes. -/
inductive MiniscopeQuant where
  /-- `off`: Do not miniscope quantifiers. -/
  | off
  /-- `conj`: Use miniscoping of conjunctions only. -/
  | conj
  /-- `fv`: Use free variable miniscoping only. -/
  | fv
  /-- `conj-and-fv`: Enable both conjunction and free variable miniscoping (the default). -/
  | conjAndFv
  /-- `agg`.

  Enable aggressive miniscope, which further may rewrite quantified formulas into a form where
  miniscoping is possible.
  -/
  | agg
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--miniscope-quant`. -/
def MiniscopeQuant.toString : MiniscopeQuant → String
  | .off => "off"
  | .conj => "conj"
  | .fv => "fv"
  | .conjAndFv => "conj-and-fv"
  | .agg => "agg"

instance : ToString MiniscopeQuant := ⟨MiniscopeQuant.toString⟩

/-- Modes to apply skolemization eagerly to bodies of quantified formulas. -/
inductive PreSkolemQuant where
  /-- `off`: Do not apply Skolemization eagerly (the default). -/
  | off
  /-- `on`: Apply Skolemization eagerly to top-level (negatively asserted) quantified formulas. -/
  | on
  /-- `agg`: Apply Skolemization eagerly and aggressively during preprocessing. -/
  | agg
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--pre-skolem-quant`. -/
def PreSkolemQuant.toString : PreSkolemQuant → String
  | .off => "off"
  | .on => "on"
  | .agg => "agg"

instance : ToString PreSkolemQuant := ⟨PreSkolemQuant.toString⟩

/-- Modes for quantifiers splitting. -/
inductive Dsplit where
  /-- `none`: Never split quantified formulas. -/
  | none
  /-- `default`.

  Split quantified formulas over some finite datatypes when finite model finding is enabled.
  -/
  | default
  /-- `agg`: Aggressively split quantified formulas. -/
  | agg
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--quant-dsplit`. -/
def Dsplit.toString : Dsplit → String
  | .none => "none"
  | .default => "default"
  | .agg => "agg"

instance : ToString Dsplit := ⟨Dsplit.toString⟩

/-- Modes for terms included in the quantifiers term database. -/
inductive TermDbMode where
  /-- `all`: Quantifiers module considers all ground terms. -/
  | all
  /-- `relevant`.

  Quantifiers module considers only ground terms connected to current assertions (the default).
  -/
  | relevant
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--term-db-mode`. -/
def TermDbMode.toString : TermDbMode → String
  | .all => "all"
  | .relevant => "relevant"

instance : ToString TermDbMode := ⟨TermDbMode.toString⟩

/-- Trigger selection modes. -/
inductive TriggerSel where
  /-- `min`: Consider only minimal subterms that meet criteria for triggers (the default). -/
  | min
  /-- `max`: Consider only maximal subterms that meet criteria for triggers. -/
  | max
  /-- `min-s-max`.

  Consider only minimal subterms that meet criteria for single triggers, maximal otherwise.
  -/
  | minSMax
  /-- `min-s-all`.

  Consider only minimal subterms that meet criteria for single triggers, all otherwise.
  -/
  | minSAll
  /-- `all`: Consider all subterms that meet criteria for triggers. -/
  | all
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--trigger-sel`. -/
def TriggerSel.toString : TriggerSel → String
  | .min => "min"
  | .max => "max"
  | .minSMax => "min-s-max"
  | .minSAll => "min-s-all"
  | .all => "all"

instance : ToString TriggerSel := ⟨TriggerSel.toString⟩

/-- Values of `--user-pat`.

These modes determine how user provided patterns (triggers) are used during E-matching. The modes
vary on when instantiation based on user-provided triggers is combined with instantiation based on
automatically selected triggers.
-/
inductive UserPat where
  /-- `use`.

  Use both user-provided and auto-generated patterns when patterns are provided for a quantified
  formula.
  -/
  | use
  /-- `trust`.

  When provided, use only user-provided patterns for a quantified formula (the default).
  -/
  | trust
  /-- `strict`.

  When provided, use only user-provided patterns for a quantified formula, and do not use any
  other instantiation techniques.
  -/
  | strict
  /-- `resort`: Use user-provided patterns only after auto-generated patterns saturate. -/
  | resort
  /-- `ignore`: Ignore user-provided patterns. -/
  | ignore
  /-- `interleave`: Alternate between use/resort. -/
  | interleave
deriving Inhabited, DecidableEq, Repr

/-- The string cvc5 expects for a value of `--user-pat`. -/
def UserPat.toString : UserPat → String
  | .use => "use"
  | .trust => "trust"
  | .strict => "strict"
  | .resort => "resort"
  | .ignore => "ignore"
  | .interleave => "interleave"

instance : ToString UserPat := ⟨UserPat.toString⟩

end Option.Quant

/-- Quantifier instantiation. -/
inductive Option.Quant where
  /-- `--enum-inst`.

  Enumerative instantiation: instantiate with ground terms from relevant domain, then arbitrary
  ground terms before answering unknown.
  -/
  | enumInst
  /-- `--full-saturate-quant`.

  Resort to full effort techniques instead of answering unknown due to limited quantifier
  reasoning. Currently enables enumerative instantiation.
  -/
  | fullSaturateQuant
  /-- `--print-inst`: Print format for printing instantiations. -/
  | printInst
  /-- `--cbqi`: Enable conflict-based quantifier instantiation. -/
  | cbqi
  /-- `--cbqi-all-conflict`.

  Add all available conflicting instances during conflict-based instantiation.
  -/
  | cbqiAllConflict
  /-- `--cbqi-mode`: What effort to apply conflict find mechanism. -/
  | cbqiMode
  /-- `--cegqi`: Turns on counterexample-based quantifier instantiation. -/
  | cegqi
  /-- `--cegqi-bv`.

  Use word-level inversion approach for counterexample-guided quantifier instantiation for
  bit-vectors.
  -/
  | cegqiBv
  /-- `--cegqi-innermost`.

  Only process innermost quantified formulas in counterexample-based quantifier instantiation.
  -/
  | cegqiInnermost
  /-- `--cegqi-midpoint`.

  Choose substitutions based on midpoints of lower and upper bounds for counterexample-based
  quantifier instantiation.
  -/
  | cegqiMidpoint
  /-- `--cegqi-nested-qe`.

  Process nested quantified formulas with quantifier elimination in counterexample-based
  quantifier instantiation.
  -/
  | cegqiNestedQe
  /-- `--e-matching`: Whether to do heuristic E-matching. -/
  | eMatching
  /-- `--elim-taut-quant`: Eliminate tautological disjuncts of quantified formulas. -/
  | elimTautQuant
  /-- `--enum-inst-interleave`: Interleave enumerative instantiation with other techniques. -/
  | enumInstInterleave
  /-- `--enum-inst-sum`.

  Enumerating tuples of quantifiers by increasing the sum of indices, rather than the maximum.
  -/
  | enumInstSum
  /-- `--ext-rewrite-quant`: Apply extended rewriting to bodies of quantified formulas. -/
  | extRewriteQuant
  /-- `--finite-model-find`: Use finite model finding heuristic for quantifier instantiation. -/
  | finiteModelFind
  /-- `--fmf-bound`: Finite model finding on bounded quantification. -/
  | fmfBound
  /-- `--fmf-type-completion-thresh`.

  The maximum cardinality of an interpreted type for which exhaustive enumeration in finite model
  finding is attempted.
  -/
  | fmfTypeCompletionThresh
  /-- `--ieval`: Mode for using instantiation evaluation. -/
  | ieval
  /-- `--inst-local`: Instantiations are local to the SAT context. -/
  | instLocal
  /-- `--inst-max-rounds`: Maximum number of instantiation rounds (-1 == no limit, default). -/
  | instMaxRounds
  /-- `--inst-no-entail`.

  Do not consider instances of quantified formulas that are currently entailed.
  -/
  | instNoEntail
  /-- `--inst-when`: When to apply instantiation. -/
  | instWhen
  /-- `--ite-lift-quant`: Ite lifting mode for quantified formulas. -/
  | iteLiftQuant
  /-- `--macros-quant`: Perform quantifiers macro expansion. -/
  | macrosQuant
  /-- `--macros-quant-mode`: Mode for quantifiers macro expansion. -/
  | macrosQuantMode
  /-- `--mbqi`: Use model-based quantifier instantiation. -/
  | mbqi
  /-- `--mbqi-check-timeout`.

  Timeout (in milliseconds) for verifying subcalls for model-based instantiation (0 == no limit).
  -/
  | mbqiCheckTimeout
  /-- `--mbqi-enum`: Use fast enumeration to augment instantiations from MBQI. -/
  | mbqiEnum
  /-- `--mbqi-one-inst-per-round`: Only add one instantiation per quantifier per round for mbqi. -/
  | mbqiOneInstPerRound
  /-- `--miniscope-quant`: Miniscope mode for quantified formulas. -/
  | miniscopeQuant
  /-- `--miniscope-quant-user`: Miniscope quantified formulas with user patterns. -/
  | miniscopeQuantUser
  /-- `--multi-trigger-cache`: Caching version of multi triggers. -/
  | multiTriggerCache
  /-- `--multi-trigger-linear`.

  Implementation of multi triggers where maximum number of instantiations is linear wrt number of
  ground terms.
  -/
  | multiTriggerLinear
  /-- `--multi-trigger-priority`.

  Only try multi triggers if single triggers give no instantiations.
  -/
  | multiTriggerPriority
  /-- `--multi-trigger-when-single`: Select multi triggers when single triggers exist. -/
  | multiTriggerWhenSingle
  /-- `--pre-skolem-quant`.

  Modes to apply skolemization eagerly to bodies of quantified formulas.
  -/
  | preSkolemQuant
  /-- `--prenex-quant-user`: Prenex quantified formulas with user patterns. -/
  | prenexQuantUser
  /-- `--print-inst-full`: Print instantiations for formulas that do not have given identifiers. -/
  | printInstFull
  /-- `--quant-alpha-equiv`: Infer alpha equivalence between quantified formulas. -/
  | alphaEquiv
  /-- `--quant-dsplit`: Mode for dynamic quantifiers splitting. -/
  | dsplit
  /-- `--relevant-triggers`: Prefer triggers that are more relevant based on SInE style analysis. -/
  | relevantTriggers
  /-- `--sub-cbqi`: Enable conflict-based instantiation subsolver strategy. -/
  | subCbqi
  /-- `--term-db-mode`: Which ground terms to consider for instantiation. -/
  | termDbMode
  /-- `--trigger-sel`: Selection mode for triggers. -/
  | triggerSel
  /-- `--user-pat`: Policy for handling user-provided patterns for quantifier instantiation. -/
  | userPat
  /-- `--var-elim-quant`: Enable simple variable elimination for quantified formulas. -/
  | varElimQuant
  /-- `--var-ent-eq-elim-quant`.

  Enable variable elimination for quantified formulas that infers entailed equalities
  corresponding to eliminations.
  -/
  | varEntEqElimQuant
  /-- `--var-ineq-elim-quant`.

  Enable variable elimination based on infinite projection of unbound arithmetic variables.
  -/
  | varIneqElimQuant
deriving Inhabited, DecidableEq, Repr

