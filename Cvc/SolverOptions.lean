/-- A solver option, by category. -/
inductive Option where
  /-- Resource limits, verbosity, statistics and incrementality. -/
  | base (opt : Option.Base)
  /-- The SMT layer: what a check can produce, self-checks, preprocessing. -/
  | smt (opt : Option.Smt)
  /-- How terms and models are printed. -/
  | printing (opt : Option.Printing)
  /-- Proof production and checking. -/
  | proof (opt : Option.Proof)
  /-- The SAT layer. -/
  | sat (opt : Option.Sat)
  /-- The theory layer, shared by every theory. -/
  | theory (opt : Option.Theory)
  /-- The arithmetic theory. -/
  | arith (opt : Option.Arith)
  /-- The theory of arrays. -/
  | arrays (opt : Option.Arrays)
  /-- The bit-vector theory. -/
  | bv (opt : Option.Bv)
  /-- The theory of strings and sequences. -/
  | strings (opt : Option.Strings)
  /-- Uninterpreted functions. -/
  | uf (opt : Option.Uf)
  /-- Quantifier instantiation. -/
  | quant (opt : Option.Quant)
  /-- Syntax-guided synthesis. -/
  | sygus (opt : Option.Sygus)
deriving Inhabited, DecidableEq, Repr

namespace Option

/-- The option's name, as cvc5 spells it. -/
def name : Option → String
  | .base opt => opt.name
  | .smt opt => opt.name
  | .printing opt => opt.name
  | .proof opt => opt.name
  | .sat opt => opt.name
  | .theory opt => opt.name
  | .arith opt => opt.name
  | .arrays opt => opt.name
  | .bv opt => opt.name
  | .strings opt => opt.name
  | .uf opt => opt.name
  | .quant opt => opt.name
  | .sygus opt => opt.name

/-- The type of the value the option expects. -/
@[expose, reducible] def argType : Option → Type
  | .base opt => opt.argType
  | .smt opt => opt.argType
  | .printing opt => opt.argType
  | .proof opt => opt.argType
  | .sat opt => opt.argType
  | .theory opt => opt.argType
  | .arith opt => opt.argType
  | .arrays opt => opt.argType
  | .bv opt => opt.argType
  | .strings opt => opt.argType
  | .uf opt => opt.argType
  | .quant opt => opt.argType
  | .sygus opt => opt.argType

/-- The value as the string cvc5 expects. -/
def valueString : (opt : Option) → opt.argType → String
  | .base opt, v => opt.valueString v
  | .smt opt, v => opt.valueString v
  | .printing opt, v => opt.valueString v
  | .proof opt, v => opt.valueString v
  | .sat opt, v => opt.valueString v
  | .theory opt, v => opt.valueString v
  | .arith opt, v => opt.valueString v
  | .arrays opt, v => opt.valueString v
  | .bv opt, v => opt.valueString v
  | .strings opt, v => opt.valueString v
  | .uf opt, v => opt.valueString v
  | .quant opt, v => opt.valueString v
  | .sygus opt, v => opt.valueString v

/-- The flag and the value to hand cvc5's string-based `setOption`. -/
def toStrings (opt : Option) (v : opt.argType) : String × String :=
  (opt.name, opt.valueString v)

end Option
